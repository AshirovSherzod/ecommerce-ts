# Base URL of the backend API
VITE_API_URL=

# The contact form sends messages through this bot
VITE_BOT_TOKEN=
VITE_CHAT_ID=

# --- Optional ---

# Sentry DSN. Unset by default: monitoring stays off and the Sentry bundle
# is never downloaded. Set it in production so crashes are visible —
# without it the only trace of a failure is the user's own console.
VITE_SENTRY_DSN=

# Both are unset by default: demo reviews and the sale countdown are shown
# in development and hidden in production builds. Set them only to override.

# "true" shows the placeholder reviews (useful on staging), "false" hides
# them even in development. The API has no reviews endpoint yet.
VITE_DEMO_REVIEWS=

# Site-wide sale deadline as an ISO date, e.g. 2026-09-30T23:59:59+05:00.
# Drives the countdown on discounted products. Leave empty in production
# unless a real campaign is running.
VITE_SALE_ENDS_AT=
